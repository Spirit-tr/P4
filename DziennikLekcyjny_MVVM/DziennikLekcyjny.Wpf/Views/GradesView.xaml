<UserControl x:Class="DziennikLekcyjny.Wpf.Views.GradesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Dodaj ocenę" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}" Margin="4,0,4,10"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Uczeń:" VerticalAlignment="Center" Margin="4" Foreground="{StaticResource MutedTextBrush}"/>
                    <ComboBox Width="210" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" DisplayMemberPath="PelneImie"/>
                    <TextBlock Text="Przedmiot:" VerticalAlignment="Center" Margin="4" Foreground="{StaticResource MutedTextBrush}"/>
                    <ComboBox Width="170" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"/>
                    <TextBlock Text="Ocena:" VerticalAlignment="Center" Margin="4" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox Width="70" Text="{Binding GradeText}"/>
                    <DatePicker SelectedDate="{Binding Date}" Width="140"/>
                    <Button Content="Dodaj ocenę" Command="{Binding AddGradeCommand}" Style="{StaticResource SuccessButtonStyle}"/>
                    <Button Content="Odśwież" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Grades}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Uczeń" Binding="{Binding Student}" Width="2*"/>
                    <DataGridTextColumn Header="Przedmiot" Binding="{Binding Przedmiot}" Width="2*"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn Header="Ocena" Binding="{Binding Ocena}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="#EEF7FF" CornerRadius="6" Padding="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
