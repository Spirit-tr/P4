<UserControl x:Class="DziennikLekcyjny.Wpf.Views.GradesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Uczeń:" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Width="210" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" DisplayMemberPath="PelneImie"/>
                <TextBlock Text="Przedmiot:" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Width="170" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"/>
                <TextBlock Text="Ocena:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Width="70" Text="{Binding GradeText}"/>
                <DatePicker SelectedDate="{Binding Date}" Width="130" Margin="4"/>
                <Button Content="Dodaj ocenę" Command="{Binding AddGradeCommand}"/>
                <Button Content="Odśwież" Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Grades}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Uczeń" Binding="{Binding Student}" Width="2*"/>
                <DataGridTextColumn Header="Przedmiot" Binding="{Binding Przedmiot}" Width="2*"/>
                <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=d}" Width="120"/>
                <DataGridTextColumn Header="Ocena" Binding="{Binding Ocena}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="DimGray" Margin="4,8,4,0"/>
    </Grid>
</UserControl>
