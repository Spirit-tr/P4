<UserControl x:Class="DziennikLekcyjny.Wpf.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdStudenta}" Width="55"/>
                    <DataGridTextColumn Header="Imię" Binding="{Binding Imie}" Width="*"/>
                    <DataGridTextColumn Header="Nazwisko" Binding="{Binding Nazwisko}" Width="*"/>
                    <DataGridTextColumn Header="PESEL" Binding="{Binding Pesel}" Width="120"/>
                    <DataGridTextColumn Header="Data ur." Binding="{Binding DataUrodzenia, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Klasa" Binding="{Binding NazwaKlasy}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Dane ucznia" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}" Margin="4,0,4,8"/>

                <TextBlock Grid.Row="1" Text="Imię" Margin="4,2,4,0" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox Grid.Row="2" Text="{Binding Imie, UpdateSourceTrigger=PropertyChanged}" Margin="4,2,4,4" Padding="8,5"/>

                <TextBlock Grid.Row="3" Text="Nazwisko" Margin="4,2,4,0" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox Grid.Row="4" Text="{Binding Nazwisko, UpdateSourceTrigger=PropertyChanged}" Margin="4,2,4,4" Padding="8,5"/>

                <TextBlock Grid.Row="5" Text="PESEL" Margin="4,2,4,0" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBox Grid.Row="6" Text="{Binding Pesel, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" Margin="4,2,4,4" Padding="8,5"/>

                <TextBlock Grid.Row="7" Text="Data urodzenia" Margin="4,2,4,0" Foreground="{StaticResource MutedTextBrush}"/>
                <DatePicker Grid.Row="8" SelectedDate="{Binding DataUrodzenia}" Margin="4,2,4,4"/>

                <TextBlock Grid.Row="9" Text="Klasa" Margin="4,2,4,0" Foreground="{StaticResource MutedTextBrush}"/>
                <ComboBox Grid.Row="10" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" Margin="4,2,4,8"/>

                <Grid Grid.Row="11" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="Nowy" Command="{Binding NewCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="4" MinHeight="34"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="Dodaj" Command="{Binding AddCommand}"
                            Style="{StaticResource SuccessButtonStyle}" Margin="4" MinHeight="34"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="Zapisz" Command="{Binding UpdateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="4" MinHeight="34"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="Usuń" Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButtonStyle}" Margin="4" MinHeight="34"/>
                    <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Odśwież" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="4" MinHeight="34"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#EEF7FF" CornerRadius="6" Padding="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
