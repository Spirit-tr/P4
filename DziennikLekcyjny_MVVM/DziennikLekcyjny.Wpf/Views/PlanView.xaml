<UserControl x:Class="DziennikLekcyjny.Wpf.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <TextBlock Text="Plan lekcji" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource HeaderBrush}" VerticalAlignment="Center"/>
            <Button Content="Odśwież plan" Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Schedule}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Klasa" Binding="{Binding NazwaKlasy}" Width="100"/>
                    <DataGridTextColumn Header="Dzień" Binding="{Binding DzienTygodnia}" Width="150"/>
                    <DataGridTextColumn Header="Godzina" Binding="{Binding Godzina, StringFormat=hh\:mm}" Width="100"/>
                    <DataGridTextColumn Header="Przedmiot" Binding="{Binding NazwaPrzedmiotu}" Width="2*"/>
                    <DataGridTextColumn Header="Nauczyciel" Binding="{Binding Nauczyciel}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="#EEF7FF" CornerRadius="6" Padding="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
