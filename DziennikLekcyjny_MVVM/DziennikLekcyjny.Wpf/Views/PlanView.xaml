<UserControl x:Class="DziennikLekcyjny.Wpf.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="Odśwież plan" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Schedule}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Klasa" Binding="{Binding NazwaKlasy}" Width="100"/>
                <DataGridTextColumn Header="Dzień" Binding="{Binding DzienTygodnia}" Width="150"/>
                <DataGridTextColumn Header="Godzina" Binding="{Binding Godzina, StringFormat=hh\\:mm}" Width="100"/>
                <DataGridTextColumn Header="Przedmiot" Binding="{Binding NazwaPrzedmiotu}" Width="2*"/>
                <DataGridTextColumn Header="Nauczyciel" Binding="{Binding Nauczyciel}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="DimGray" Margin="4,8,4,0"/>
    </Grid>
</UserControl>
