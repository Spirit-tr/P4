<Window x:Class="DziennikLekcyjny.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DziennikLekcyjny.Wpf.Views"
        Title="Dziennik lekcyjny" Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="22,18">
            <TextBlock Text="Dziennik lekcyjny" FontSize="30" FontWeight="Bold" Foreground="White"/>
        </Border>

        <Border Grid.Row="1" Margin="18" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="6">
            <TabControl Background="White" BorderThickness="0">
                <TabItem Header="Uczniowie">
                    <views:StudentsView DataContext="{Binding Students}"/>
                </TabItem>
                <TabItem Header="Oceny">
                    <views:GradesView DataContext="{Binding Grades}"/>
                </TabItem>
                <TabItem Header="Plan lekcji">
                    <views:PlanView DataContext="{Binding Plan}"/>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="2" Background="#EAF2FB" Padding="18,9">
            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                       Text="Baza: Projekt bazy danych dziennika lekcyjnego  •  Serwer: .\SQLEXPRESS"/>
        </Border>
    </Grid>
</Window>
