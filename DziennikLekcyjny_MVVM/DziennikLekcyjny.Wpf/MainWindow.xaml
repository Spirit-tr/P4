<Window x:Class="DziennikLekcyjny.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DziennikLekcyjny.Wpf.Views"
        Title="Dziennik lekcyjny" Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Dziennik lekcyjny" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="WPF + SQL Server + MVVM" Foreground="Gray"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Uczniowie">
                <views:StudentsView DataContext="{Binding Students}"/>
            </TabItem>
            <TabItem Header="Oceny">
                <views:GradesView DataContext="{Binding Grades}"/>
            </TabItem>
            <TabItem Header="Plan lekcji">
                <views:PlanView DataContext="{Binding Plan}"/>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="4,8,4,0" Foreground="DimGray"
                   Text="Baza: Projekt bazy danych dziennika lekcyjnego | Serwer: .\\SQLEXPRESS"/>
    </Grid>
</Window>
